POSTGRES_USER=n8n
POSTGRES_PASSWORD=CHANGE_THIS_PASSWORD
POSTGRES_DB=n8n

# Generate using: openssl rand -hex 16
N8N_ENCRYPTION_KEY=CHANGE_THIS_KEY

# Generate using: openssl rand -hex 16
N8N_RUNNERS_AUTH_TOKEN=CHANGE_THIS_TOKEN

